---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import { siteConfig, marqueeItems, experience, projects, stack } from '../data/portfolio';
---
<Layout>
  <header class="nav" id="nav">
    <a class="brand" href="#top" aria-label="Benjamin Caceres, inicio">
      <span class="brand-mark" aria-hidden="true">kc</span>
      <span class="brand-name">kcrs.cl</span>
    </a>
    <button class="nav-toggle" id="navToggle" aria-expanded="false" aria-controls="navLinks">Menú</button>
    <nav id="navLinks" class="nav-links" aria-label="Principal">
      <a href="#perfil">Perfil</a>
      <a href="#experiencia">Experiencia</a>
      <a href="#proyectos">Proyectos</a>
      <a href="#formacion">Formación</a>
      <a href="#stack">Stack</a>
      <a href="#contacto">Contacto</a>
    </nav>
  </header>

  <main>
    <section class="hero">
      <div class="hero-copy">
        <p class="hero-place">{siteConfig.location}</p>
        <h1>{siteConfig.name}</h1>
        <p class="hero-lead">Monitoreo, detecto y documento incidentes de seguridad. Busco mi primer rol como analista SOC.</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="#proyectos">Ver proyectos</a>
          <a class="btn" href="#contacto">Contactar</a>
        </div>
        <ul class="socials" aria-label="Redes">
          <li><a href={siteConfig.github} rel="me noopener" target="_blank" data-social="github">GitHub</a></li>
          <li><a href={siteConfig.linkedin} rel="me noopener" target="_blank" data-social="linkedin">LinkedIn</a></li>
        </ul>
      </div>

      <div class="terminal" role="img" aria-label="Terminal con resumen del perfil: rol, foco y certificaciones">
        <div class="terminal-bar"><span></span><span></span><span></span><b>bcaceres@elqui:~</b></div>
        <pre id="termOut" class="terminal-body"></pre>
      </div>
    </section>

    <div class="marquee" aria-hidden="true">
      <div class="marquee-track">
        {[...marqueeItems, ...marqueeItems].map((item) => <span>{item}</span>)}
      </div>
    </div>

    <section id="perfil" class="section">
      <p class="kicker">Perfil</p>
      <h2>Aprendo atacando y defendiendo, y lo dejo por escrito.</h2>
      <div class="profile-grid">
        <div class="prose">
          <p>Soy técnico en ciberseguridad y estudio Ingeniería en Ciberseguridad. Pasé por TI en el Hospital de Vicuña y por la Municipalidad de Vicuña, donde desplegué un SIEM con Wazuh para centralizar el monitoreo.</p>
          <p>Fuera del trabajo armo mis propias herramientas: una plataforma OSINT, un monitor de precios y una plataforma de ayuda académica. Documento cada análisis con evidencia, severidad y plan de remediación.</p>
        </div>
        <div class="cards3">
          <article class="mini">
            <h3>Monitoreo y detección</h3>
            <p>Wazuh como SIEM, correlación de eventos y revisión de alertas.</p>
          </article>
          <article class="mini">
            <h3>Vulnerabilidades y pentesting</h3>
            <p>Escaneo con Nmap y Nessus, explotación en laboratorio e informes técnicos.</p>
          </article>
          <article class="mini">
            <h3>Gobierno y auditoría</h3>
            <p>Auditor interno ISO 27001: controles, evidencia y hallazgos.</p>
          </article>
        </div>
      </div>
    </section>

    <section id="experiencia" class="section">
      <p class="kicker">Experiencia</p>
      <h2>Dónde he trabajado</h2>
      <ol class="timeline">
        {experience.map((job) => (
          <li class="job">
            <div class="job-head">
              <h3>{job.role}</h3>
              <p class="org">{job.org}</p>
            </div>
            <div class="job-body">
              <p>{job.description}</p>
              <ul class="tags">
                {job.tags.map((tag) => <li>{tag}</li>)}
              </ul>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section id="proyectos" class="section">
      <p class="kicker">Proyectos</p>
      <h2>Lo que he construido y analizado</h2>
      <div class="projects">
        {projects.map((proj) => (
          <article class={`project ${proj.featured ? 'project-feature' : ''}`}>
            {proj.featured && (
              <div class="project-visual osint" aria-hidden="true">
                <svg viewBox="0 0 320 180" role="presentation">
                  <g stroke="currentColor" stroke-width="1.2" fill="none" opacity=".55">
                    <path d="M60 90 L130 40 L210 70 L260 130 L170 140 L60 90 L170 140 M130 40 L170 140 M210 70 L170 140"/>
                  </g>
                  <g fill="currentColor">
                    <circle cx="60" cy="90" r="6"/><circle cx="130" cy="40" r="7"/><circle cx="210" cy="70" r="6"/>
                    <circle cx="260" cy="130" r="5"/><circle cx="170" cy="140" r="9"/>
                  </g>
                </svg>
              </div>
            )}
            <div class="project-body">
              <p class="meta">{proj.meta}</p>
              <h3>{proj.title}</h3>
              <p>{proj.description}</p>
              <ul class="tags">
                {proj.tags.map((tag) => <li>{tag}</li>)}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="formacion" class="section">
      <p class="kicker">Formación</p>
      <h2>Estudios y certificaciones</h2>
      <div class="edu-grid">
        <div>
          <h3 class="col-title">Académico</h3>
          <ul class="edu-list">
            <li><strong>Ingeniería en Ciberseguridad</strong><span>En curso</span></li>
            <li><strong>Técnico en Ciberseguridad</strong><span>Titulado</span></li>
          </ul>
        </div>
        <div>
          <h3 class="col-title">Certificaciones obtenidas</h3>
          <ul class="certs">
            <li><strong>eJPTv2</strong><span>Junior Penetration Tester · INE Security</span></li>
            <li><strong>ICCA</strong><span>Certificación en ciberseguridad</span></li>
            <li><strong>Ethical Hacker</strong><span>Cisco Networking Academy</span></li>
            <li><strong>Auditor interno ISO 27001</strong><span>Sistema de gestión de seguridad de la información</span></li>
          </ul>
        </div>
        <div>
          <h3 class="col-title">En preparación</h3>
          <ul class="certs certs-next">
            <li><strong>CDSA</strong><span>Certified Defensive Security Analyst</span></li>
            <li><strong>SC-200</strong><span>Microsoft Security Operations Analyst</span></li>
          </ul>
        </div>
      </div>
    </section>

    <section id="stack" class="section">
      <p class="kicker">Stack</p>
      <h2>Herramientas que uso</h2>
      <div class="stack-grid">
        {stack.map((group) => (
          <div class="stack-col">
            <h3>{group.category}</h3>
            <ul class="tags">
              {group.items.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section id="contacto" class="section contact">
      <p class="kicker">Contacto</p>
      <h2>Escríbeme.</h2>
      <p class="contact-lead">Estoy buscando roles de analista SOC, seguridad TI y soporte TI. También converso sobre proyectos de seguridad y monitoreo.</p>
      <div class="contact-actions">
        <a class="btn btn-primary" id="mailBtn" href={`mailto:${siteConfig.email}`}>Enviar correo</a>
        <button class="btn" id="copyBtn" type="button" data-email={siteConfig.email}>Copiar correo</button>
        <span class="status" id="copyStatus" role="status" aria-live="polite"></span>
      </div>
      <p class="contact-meta">Vicuña, Chile · Hora de Chile</p>
    </section>
  </main>

  <footer class="footer">
    <p>© <span id="year">2026</span> {siteConfig.name}</p>
    <a href="#top">Volver arriba</a>
  </footer>
</Layout>